# Zkopíruj tento soubor jako .env a doplň hodnoty. Soubor .env se NIKDY necommituje.

# Prostředí: development / production (v production se odmítne výchozí SECRET_KEY)
ENVIRONMENT=development

# Databáze – lokálně SQLite, v produkci PostgreSQL (Supabase/Render)
# postgresql://uzivatel:heslo@host:5432/databaze
DATABASE_URL=sqlite:///./studybuddy.db

# Tajný klíč pro podepisování JWT tokenů. Vygeneruj např.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=zmen-me-na-dlouhy-nahodny-retezec

# Platnost přihlášení v minutách (výchozí 7 dní)
ACCESS_TOKEN_MINUTES=10080

# Google Gemini – klíč z https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Povolené adresy frontendu (oddělené čárkou)
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Limity vstupu
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=200000
