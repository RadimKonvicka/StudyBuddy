---
// vyklad podtematu na miru urovni uzivatele + karticky; kdyz vyklad jeste neni, rovnou ho vytvori AI
import Layout from "../layouts/Layout.astro";
---
<Layout title="Výklad">
  <div id="lesson" class="max-w-3xl mx-auto">
    <p class="text-muted text-sm">Načítám…</p>
  </div>
</Layout>

<script>
  import { api } from "../lib/api.js";
  import { esc, md, toast } from "../lib/dom.js";
  import { AI_TIMEOUT, aiLoading, idFromUrl, levelChip, masteryBar } from "../lib/learning.js";

  const root = document.getElementById("lesson");
  const subtopicId = idFromUrl();
  let data = null;

  const LEVEL_NOTE = {
    weak: "Výklad je napsaný od úplných základů, protože ti toto podtéma zatím nejde.",
    mid: "Výklad se soustředí hlavně na místa, kde jsi v testu chyboval.",
    strong: "Podtéma už zvládáš, výklad je stručný a jde víc do hloubky.",
  };

  function render() {
    const s = data.subtopic;
    document.title = `${s.name} | StudyBuddy`;
    root.innerHTML = `
      <a href="/subject?id=${data.subject_id}" class="text-sm text-muted hover:text-ink">← ${esc(data.subject_title)}</a>
      <div class="flex flex-wrap items-center gap-3 mt-1">
        <h1 class="text-2xl font-semibold">${esc(s.name)}</h1>
        ${levelChip(s.level)}
      </div>
      <div class="mt-3">${masteryBar(s.mastery, s.level)}</div>
      ${s.level ? `<p class="text-sm text-muted mt-2">${LEVEL_NOTE[s.level]}</p>` : ""}

      <article class="card p-5 mt-4 md">${md(data.content)}</article>

      <div class="card p-4 mt-4 flex flex-wrap items-center gap-3">
        <div class="flex-1 min-w-48">
          <div class="font-medium">Umíš to?</div>
          <div class="text-sm text-muted">Procvičovací test ti upraví zvládnutí podtématu.</div>
        </div>
        <button id="practice" class="btn-primary">Otestovat se</button>
      </div>

      ${data.flashcards.length ? `
        <div class="flex flex-wrap items-baseline justify-between gap-2 mt-8 mb-3">
          <h2 class="text-lg font-semibold">Kartičky <span class="text-muted font-normal text-sm">(klikni pro otočení)</span></h2>
          <a href="/review" class="text-sm text-accent">Opakovat kartičky →</a>
        </div>
        <div class="grid sm:grid-cols-2 gap-3">
          ${data.flashcards.map((c) => `
            <button class="flip h-36 text-left cursor-pointer" aria-label="Otočit kartičku">
              <div class="flip-inner h-full">
                <div class="face card p-4 flex items-center justify-center text-center font-medium">${esc(c.front)}</div>
                <div class="face back rounded-lg border border-accent p-4 flex items-center justify-center text-center text-sm bg-accent-soft">${esc(c.back)}</div>
              </div>
            </button>`).join("")}
        </div>` : ""}

      <div class="mt-8 pt-4 border-t border-line">
        <button id="regenerate" class="text-sm text-muted hover:text-ink cursor-pointer">Napsat výklad znovu podle aktuální úrovně</button>
        <p class="text-xs text-muted">Hodí se, když ses mezitím zlepšil. Kartičky k podtématu se vytvoří nové.</p>
      </div>`;

    root.querySelectorAll(".flip").forEach((card) => card.addEventListener("click", () => card.classList.toggle("flipped")));
    document.getElementById("practice").addEventListener("click", practice);
    document.getElementById("regenerate").addEventListener("click", generate);
  }

  async function generate() {
    root.innerHTML = aiLoading(`Píšu výklad na míru tvé úrovni: ${data.subtopic.name}`);
    try {
      data = await api(`/api/subtopics/${subtopicId}/lesson`, { method: "POST", timeout: AI_TIMEOUT });
      render();
      window.scrollTo({ top: 0 });
    } catch (err) {
      showError(err.message, data.content !== null);
    }
  }

  async function practice() {
    root.innerHTML = aiLoading(`Připravuji procvičovací test: ${data.subtopic.name}`);
    try {
      const res = await api(`/api/subtopics/${subtopicId}/quiz`, { method: "POST", timeout: AI_TIMEOUT });
      location.href = `/quiz?id=${res.quiz_id}`;
    } catch (err) {
      toast(err.message, "error");
      render();
    }
  }

  function showError(message, hasLesson) {
    if (hasLesson) {
      toast(message, "error");
      render();
      return;
    }
    root.innerHTML = `
      <a href="/subject?id=${data.subject_id}" class="text-sm text-muted hover:text-ink">← ${esc(data.subject_title)}</a>
      <div class="card p-5 mt-3">
        <p class="text-weak">${esc(message)}</p>
        <button id="retry" class="btn-primary mt-3">Zkusit znovu</button>
      </div>`;
    document.getElementById("retry").addEventListener("click", generate);
  }

  async function load() {
    if (!subtopicId) {
      root.innerHTML = `<p>Podtéma nebylo nalezeno. <a href="/" class="text-accent">Zpět na přehled</a></p>`;
      return;
    }
    try {
      data = await api(`/api/subtopics/${subtopicId}`);
    } catch (err) {
      root.innerHTML = `<p class="text-weak">${esc(err.message)}</p><a href="/" class="text-accent text-sm">Zpět na přehled</a>`;
      return;
    }
    // vyklad jeste neexistuje → rovnou ho nechame napsat
    data.content === null ? generate() : render();
  }

  load();
</script>
