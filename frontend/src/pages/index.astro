---
// prehled - zatim jen info o uctu, statistiky pridam pozdeji
import Layout from "../layouts/Layout.astro";
---
<Layout title="Přehled">
  <h1 class="text-2xl font-semibold" id="greeting">Přehled</h1>

  <div class="card p-5 mt-4">
    <h2 class="font-semibold mb-3">Můj účet</h2>
    <table id="me" class="text-sm">
      <tr><td class="text-muted">Načítám...</td></tr>
    </table>
  </div>
</Layout>

<script>
  import { api } from "../lib/api.js";
  import { updateUser } from "../lib/auth.js";
  import { esc, toast } from "../lib/dom.js";

  async function load() {
    try {
      const me = await api("/api/auth/me");
      updateUser(me);
      document.getElementById("greeting").textContent = `Ahoj, ${me.display_name}`;
      document.getElementById("me").innerHTML = `
        <tr><td class="text-muted pr-6 py-1">E-mail</td><td>${esc(me.email)}</td></tr>
        <tr><td class="text-muted pr-6 py-1">XP</td><td>${me.xp}</td></tr>
        <tr><td class="text-muted pr-6 py-1">Série dní</td><td>${me.streak}</td></tr>`;
    } catch (err) {
      toast(err.message, "error");
    }
  }

  load();
</script>
